{
  "name": "talaria/php-sdk",
  "description": "Talaria PHP SDK monorepo — talaria/talaria, talaria/silverstripe, talaria/laravel",
  "license": "MIT",
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "test": [
      "@test:talaria"
    ],
    "test:talaria": "composer --working-dir=packages/talaria test",
    "test:silverstripe": "composer --working-dir=packages/silverstripe test",
    "test:laravel": "composer --working-dir=packages/laravel test",
    "phpstan": "composer --working-dir=packages/talaria phpstan",
    "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php"
  },
  "config": {
    "sort-packages": true
  }
}
