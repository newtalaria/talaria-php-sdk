parameters:
	ignoreErrors:
		-
			message: '#^Cannot access offset 1 on array\|false\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/Flags/LocalFlagEvaluator.php

		-
			message: '#^Method Talaria\\Flags\\LocalFlagEvaluator\:\:serve\(\) should return array\{key\: string, variationKey\: string, value\: mixed, version\: int, reason\: string, valueJson\: string\|null\} but returns array\{key\: string, variationKey\: string, value\: mixed, version\: int, reason\: string, valueJson\: string\|false\|null\}\.$#'
			identifier: return.type
			count: 1
			path: src/Flags/LocalFlagEvaluator.php

		-
			message: '#^Parameter \#1 \$flag of method Talaria\\Flags\\LocalFlagEvaluator\:\:evaluate\(\) expects array\{key\: string, kind\?\: string, variations\: list\<array\{key\: string, valueJson\?\: string\|null, value\?\: mixed, name\?\: string\|null\}\>, rules\?\: list\<array\<string, mixed\>\>, defaultVariationKey\: string, offVariationKey\: string, enabled\?\: bool, version\?\: int\}, non\-empty\-array\<string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Flags/LocalFlagEvaluator.php

		-
			message: '#^Strict comparison using \!\=\= between array\<string, string\>\|float\|int\|string and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Monitor/MonitorCheckIn.php

		-
			message: '#^Method Talaria\\TalariaClient\:\:debug\(\) has parameter \$context with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/TalariaClient.php

		-
			message: '#^Method Talaria\\TalariaClient\:\:error\(\) has parameter \$context with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/TalariaClient.php

		-
			message: '#^Method Talaria\\TalariaClient\:\:fatal\(\) has parameter \$context with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/TalariaClient.php

		-
			message: '#^Method Talaria\\TalariaClient\:\:info\(\) has parameter \$context with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/TalariaClient.php

		-
			message: '#^Method Talaria\\TalariaClient\:\:log\(\) has parameter \$context with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/TalariaClient.php

		-
			message: '#^Method Talaria\\TalariaClient\:\:warn\(\) has parameter \$context with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/TalariaClient.php

		-
			message: '#^Method Talaria\\TalariaClient\:\:warning\(\) has parameter \$context with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/TalariaClient.php

		-
			message: '#^Parameter \#1 \$options of class Talaria\\Config constructor expects array\{url\?\: string, apiKey\: string, release\?\: string\|null, commitSha\?\: string\|null, sampleRate\?\: float\|int, maxBatchSize\?\: int, flushIntervalMs\?\: int, defaultIntegrations\?\: bool, \.\.\.\}, array\<string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/TalariaClient.php

		-
			message: '#^Using nullsafe method call on non\-nullable type Talaria\\Transport\\IngestError\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/TalariaClient.php

		-
			message: '#^Offset ''type'' on array\{__className__\: ''BreadcrumbDto'', timestamp\: string, type\: non\-empty\-string, category\?\: non\-empty\-string, message\?\: non\-empty\-string, level\?\: non\-empty\-string, data\?\: non\-empty\-array\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Tracing/BreadcrumbBuffer.php

		-
			message: '#^Call to an undefined method object\:\:handle\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Tracing/Psr15Middleware.php

		-
			message: '#^Method Talaria\\Tracing\\RedisClientProxy\:\:__call\(\) has parameter \$arguments with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Tracing/RedisClientProxy.php

		-
			message: '#^Trying to invoke \(callable\(\)\: float\)\|null but it might not be a callable\.$#'
			identifier: callable.nonCallable
			count: 2
			path: src/Tracing/SpanQueue.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: src/Tracing/Tracer.php

		-
			message: '#^Using nullsafe property access "\?\-\>traceId" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Tracing/Tracer.php

		-
			message: '#^Using nullsafe property access on non\-nullable type Talaria\\Tracing\\Span\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Tracing/Tracer.php

		-
			message: '#^Method Talaria\\Tracing\\TracingPdo\:\:__call\(\) has parameter \$arguments with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Tracing/TracingPdo.php

		-
			message: '#^Method Talaria\\Tracing\\TracingPdoStatement\:\:__call\(\) has parameter \$arguments with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Tracing/TracingPdoStatement.php

		-
			message: '#^Method Talaria\\Tracing\\TracingPdoStatement\:\:execute\(\) has parameter \$params with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Tracing/TracingPdoStatement.php

		-
			message: '#^Trying to invoke \(callable\(\)\: float\)\|null but it might not be a callable\.$#'
			identifier: callable.nonCallable
			count: 2
			path: src/Transport/EventQueue.php
